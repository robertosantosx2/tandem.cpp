diff --git a/src/nepenthes_trace.hpp b/src/nepenthes_trace.hpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/nepenthes_trace.hpp
@@ -0,0 +1,79 @@
+#pragma once
+
+// NEPENTHES low-overhead trace hook. C++17, no heap allocation on emit.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace nepenthes {
+enum class EventType : std::uint8_t {
+    request_start, request_end, model_load, model_unload, routing,
+    cache_hit, cache_miss, eviction, prefetch, kv_cache,
+    allocation, free_event, transfer, kernel, sync, cpu_work, stall, oom,
+    fallback, error,
+};
+enum EventFlags : std::uint16_t {
+    phase_instant = 0, phase_begin = 1u << 0, phase_end = 1u << 1,
+    flag_failed = 1u << 2, flag_host = 1u << 3, flag_device = 1u << 4,
+};
+struct Event {
+    std::uint64_t monotonic_ns = 0, duration_ns = 0, request_id = 0;
+    std::uint64_t value0 = 0, value1 = 0;
+    EventType type = EventType::error;
+    std::uint16_t flags = phase_instant;
+    const char * label = nullptr; // borrowed; consume synchronously
+};
+// Server task IDs start at zero, while request_id=0 means uncorrelated.
+// Preserve the raw task ID in event values and map valid IDs into [1, UINT64_MAX].
+inline std::uint64_t request_id_from_task_id(std::int64_t task_id) noexcept {
+    return task_id < 0 ? 0 : static_cast<std::uint64_t>(task_id) + 1;
+}
+using Sink = void (*)(const Event &) noexcept;
+inline std::atomic<Sink> & sink_slot() noexcept {
+    static std::atomic<Sink> slot{nullptr};
+    return slot;
+}
+inline std::uint64_t now_ns() noexcept {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+// Install before worker threads start; disable after they stop. Never hot-swap
+// while producers are active. The sink must be non-blocking and thread-safe.
+inline void set_sink(Sink sink) noexcept {
+    sink_slot().store(sink, std::memory_order_release);
+}
+inline void emit(EventType type, const char * label = nullptr,
+                 std::uint64_t value0 = 0, std::uint64_t value1 = 0,
+                 std::uint16_t flags = phase_instant,
+                 std::uint64_t request_id = 0,
+                 std::uint64_t duration_ns = 0) noexcept {
+    const Sink sink = sink_slot().load(std::memory_order_acquire);
+    if (!sink) return;
+    Event e;
+    e.monotonic_ns = now_ns();
+    e.duration_ns = duration_ns;
+    e.request_id = request_id;
+    e.value0 = value0;
+    e.value1 = value1;
+    e.type = type;
+    e.flags = flags;
+    e.label = label;
+    sink(e);
+}
+class ScopedEvent {
+public:
+    ScopedEvent(EventType type, const char * label, std::uint64_t value0 = 0,
+                std::uint64_t value1 = 0, std::uint64_t request_id = 0) noexcept
+        : type_(type), label_(label), value0_(value0), value1_(value1),
+          request_id_(request_id), start_ns_(now_ns()) {
+        emit(type_, label_, value0_, value1_, phase_begin, request_id_);
+    }
+    ScopedEvent(const ScopedEvent &) = delete;
+    ScopedEvent & operator=(const ScopedEvent &) = delete;
+    ~ScopedEvent() noexcept {
+        const auto end_ns = now_ns();
+        emit(type_, label_, value0_, value1_, phase_end, request_id_,
+             end_ns >= start_ns_ ? end_ns - start_ns_ : 0);
+    }
+private:
+    EventType type_;
+    const char * label_;
+    std::uint64_t value0_, value1_, request_id_, start_ns_;
+};
+} // namespace nepenthes
