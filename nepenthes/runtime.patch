diff --git a/src/nepenthes_trace.hpp b/src/nepenthes_trace.hpp
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/src/nepenthes_trace.hpp
@@ -0,0 +1,196 @@
+#pragma once
+
+// NEPENTHES observability hook for tandem.cpp / llama.cpp.
+// C++17, header-only, no heap allocation on the emit path.
+//
+// The sink must be installed before worker threads start and removed only
+// after they have stopped. Disabling a sink also waits for callbacks that
+// already entered it, so its context may be safely destroyed after set_sink
+// returns. Labels are borrowed string literals and must be consumed
+// synchronously by the sink.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+namespace nepenthes {
+
+enum class EventType : std::uint8_t {
+    request_start, request_end,
+    model_load, model_unload,
+    routing, cache_hit, cache_miss, eviction, prefetch,
+    kv_cache, allocation, free_event, transfer, kernel,
+    sync, cpu_work, stall, oom, fallback, nvtx_marker, error,
+};
+
+enum EventFlags : std::uint16_t {
+    phase_instant = 0,
+    phase_begin = 1u << 0,
+    phase_end = 1u << 1,
+    flag_failed = 1u << 2,
+    flag_host = 1u << 3,
+    flag_device = 1u << 4,
+};
+
+struct Event {
+    std::uint64_t monotonic_ns = 0;
+    std::uint64_t duration_ns = 0;
+    std::uint64_t request_id = 0; // zero means not correlated
+    std::uint64_t correlation_token = 0; // exact batch/job identity, not necessarily one request
+    std::uint64_t value0 = 0;
+    std::uint64_t value1 = 0;
+    EventType type = EventType::error;
+    std::uint16_t flags = phase_instant;
+    const char * label = nullptr; // borrowed; sink consumes during callback
+};
+
+// Server task IDs start at zero, while request_id=0 means uncorrelated.
+// Preserve the raw task ID in event values and map valid IDs into [1, UINT64_MAX].
+inline std::uint64_t request_id_from_task_id(std::int64_t task_id) noexcept {
+    return task_id < 0 ? 0 : static_cast<std::uint64_t>(task_id) + 1;
+}
+
+using Sink = void (*)(const Event &) noexcept;
+
+inline std::atomic<Sink> & sink_slot() noexcept {
+    static std::atomic<Sink> slot{nullptr};
+    return slot;
+}
+
+inline std::atomic<std::uint32_t> & active_emitters() noexcept {
+    static std::atomic<std::uint32_t> count{0};
+    return count;
+}
+
+inline std::atomic<std::uint64_t> & correlation_sequence() noexcept {
+    static std::atomic<std::uint64_t> sequence{1};
+    return sequence;
+}
+
+inline std::uint64_t next_correlation_token() noexcept {
+    std::uint64_t token = correlation_sequence().fetch_add(1, std::memory_order_relaxed);
+    if (token == 0) {
+        token = correlation_sequence().fetch_add(1, std::memory_order_relaxed);
+    }
+    return token;
+}
+
+inline std::uint64_t & current_batch_token_slot() noexcept {
+    static thread_local std::uint64_t token = 0;
+    return token;
+}
+
+inline std::uint64_t current_batch_token() noexcept {
+    return current_batch_token_slot();
+}
+
+class BatchScope {
+public:
+    explicit BatchScope(std::uint64_t token) noexcept
+        : previous_(current_batch_token_slot()) {
+        current_batch_token_slot() = token;
+    }
+    BatchScope(const BatchScope &) = delete;
+    BatchScope & operator=(const BatchScope &) = delete;
+    ~BatchScope() noexcept {
+        current_batch_token_slot() = previous_;
+    }
+private:
+    std::uint64_t previous_;
+};
+
+inline std::uint64_t now_ns() noexcept {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// Install/disable only at a controlled lifecycle boundary, never while
+// producer threads are concurrently being created or destroyed. Disabling
+// first prevents new callbacks, then waits for callbacks already in flight.
+inline void set_sink(Sink sink) noexcept {
+    sink_slot().store(sink, std::memory_order_release);
+    if (sink == nullptr) {
+        while (active_emitters().load(std::memory_order_acquire) != 0) {
+            std::this_thread::yield();
+        }
+    }
+}
+
+inline void emit_with_token(EventType type, const char * label,
+                             std::uint64_t value0, std::uint64_t value1,
+                             std::uint16_t flags, std::uint64_t request_id,
+                             std::uint64_t duration_ns,
+                             std::uint64_t correlation_token) noexcept {
+    const Sink sink = sink_slot().load(std::memory_order_acquire);
+    if (sink == nullptr) return;
+
+    active_emitters().fetch_add(1, std::memory_order_acq_rel);
+    if (sink_slot().load(std::memory_order_acquire) != sink) {
+        active_emitters().fetch_sub(1, std::memory_order_release);
+        return;
+    }
+
+    Event event;
+    event.monotonic_ns = now_ns();
+    event.duration_ns = duration_ns;
+    event.request_id = request_id;
+    event.correlation_token = correlation_token;
+    event.value0 = value0;
+    event.value1 = value1;
+    event.type = type;
+    event.flags = flags;
+    event.label = label;
+    sink(event);
+    active_emitters().fetch_sub(1, std::memory_order_release);
+}
+
+inline void emit(EventType type, const char * label = nullptr,
+                 std::uint64_t value0 = 0, std::uint64_t value1 = 0,
+                 std::uint16_t flags = phase_instant,
+                 std::uint64_t request_id = 0,
+                 std::uint64_t duration_ns = 0,
+                 std::uint64_t correlation_token = 0) noexcept {
+    if (correlation_token == 0) {
+        correlation_token = current_batch_token();
+    }
+    emit_with_token(type, label, value0, value1, flags, request_id,
+                    duration_ns, correlation_token);
+}
+
+class ScopedEvent {
+public:
+    ScopedEvent(EventType type, const char * label,
+                std::uint64_t value0 = 0, std::uint64_t value1 = 0,
+                std::uint64_t request_id = 0,
+                std::uint64_t correlation_token = 0) noexcept
+        : type_(type), label_(label), value0_(value0), value1_(value1),
+          request_id_(request_id),
+          correlation_token_(correlation_token != 0 ? correlation_token : current_batch_token()),
+          start_ns_(now_ns()) {
+        emit_with_token(type_, label_, value0_, value1_, phase_begin, request_id_, 0,
+                        correlation_token_);
+    }
+
+    ScopedEvent(const ScopedEvent &) = delete;
+    ScopedEvent & operator=(const ScopedEvent &) = delete;
+
+    ~ScopedEvent() noexcept {
+        const std::uint64_t end_ns = now_ns();
+        emit_with_token(type_, label_, value0_, value1_, phase_end, request_id_,
+                        end_ns >= start_ns_ ? end_ns - start_ns_ : 0,
+                        correlation_token_);
+    }
+
+private:
+    EventType type_;
+    const char * label_;
+    std::uint64_t value0_;
+    std::uint64_t value1_;
+    std::uint64_t request_id_;
+    std::uint64_t correlation_token_;
+    std::uint64_t start_ns_;
+};
+
+} // namespace nepenthes
